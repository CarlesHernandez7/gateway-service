# Gateway Service Environment Variables
PORT=8090

# JWT - Must be the SAME secret key used by user-service
JWT_SECRET_KEY=****

# Internal API Key - Must be the SAME in all microservices and the gateway
INTERNAL_API_KEY=****

# Service URLs
USER_SERVICE_URL=http://localhost:8080
BUDGET_SERVICE_URL=http://localhost:8083
ORGANIZATION_SERVICE_URL=http://localhost:8086
PAYMENT_SERVICE_URL=http://localhost:8081
AGENDA_SERVICE_URL=http://localhost:8082

# Only used by docker compose (the values above point to localhost, which inside a container is the
# gateway itself). Defaults: http://user-service:8080 on the microservices-net network. Uncomment to override.
DOCKER_USER_SERVICE_URL=http://user-service:8080
# DOCKER_BUDGET_SERVICE_URL=http://budget-service:8083
# DOCKER_ORGANIZATION_SERVICE_URL=http://organization-service:8086

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
